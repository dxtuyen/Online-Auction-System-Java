<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620" prefWidth="920" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.BiddingController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="btn-secondary" text="← Quay lại" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label styleClass="label-muted" text="Số dư:" />
            <Label fx:id="lblBalance" styleClass="label-price" text="1000000" />
            <Label styleClass="label-muted" text="| Doanh thu: " />
            <Label fx:id="lblRevenue" styleClass="label-price" text="Label" />
            <Label fx:id="lblTimer" style="-fx-background-color: #f0fdf4; box-border-color: #bbf7d0; -fx-background-radius: 6; -fx-border-radius: 6;" styleClass="timer-normal" text="⏱ 00:00:00" textFill="#059669">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" left="14.0" right="14.0" top="5.0" />
               </padding>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <HBox prefHeight="100.0" spacing="16.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="14.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox prefHeight="331.0" prefWidth="442.0" spacing="10.0" styleClass="card">
                     <children>
                        <Label fx:id="lblItemName" styleClass="label-title" />
                        <Label fx:id="lblItemInfo" styleClass="label-muted" />
                        <Separator prefHeight="0.0" prefWidth="403.0">
                           <opaqueInsets>
                              <Insets top="10.0" />
                           </opaqueInsets>
                        </Separator>
                        <GridPane prefHeight="300.0" prefWidth="400.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <Label styleClass="label-muted" text="Giá khởi điểm:" textFill="#6b7280" />
                              <Label styleClass="label-muted" text="Giá hiện tại:" GridPane.rowIndex="1" />
                              <Label styleClass="label-muted" text="Bước nhảy tối thiểu:" GridPane.rowIndex="2" />
                              <Label styleClass="label-muted" text="Lượt bid:" GridPane.rowIndex="3" />
                              <Label styleClass="label-muted" text="Người dẫn đầu:" GridPane.rowIndex="4" />
                              <Label fx:id="lblStartPrice" text="1000000" GridPane.columnIndex="1" />
                              <Label fx:id="lblCurrentPrice" text="50000000" textFill="#059669" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblBidCount" text="12" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              <Label fx:id="lblLeader" text="abc" textFill="#3a6cc9" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblIncrement" text="100000" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <VBox prefHeight="157.0" prefWidth="399.0" styleClass="card">
                     <children>
                        <Label styleClass="column-header" text="💰 Đặt giá">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
                           <children>
                              <TextField fx:id="txtBidAmount" promptText="Nhập giá muốn đặt..." styleClass="text-input" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnPlaceBid" mnemonicParsing="false" onAction="#handlePlaceBid" prefHeight="33.0" prefWidth="89.0" styleClass="btn-primary" text="Đặt giá" />
                           </children>
                           <padding>
                              <Insets top="10.0" />
                           </padding>
                        </HBox>
                        <Label fx:id="lblError" styleClass="label-muted" />
                     </children>
                  </VBox>

                  <VBox style="-fx-background-color: #f0f9ff; box-border-color: #bae6fd;" styleClass="card">
                     <children>
                        <Label styleClass="column-header" text="🤖 Auto-Bid — Đặt giá tự động">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
                           <children>
                              <TextField fx:id="txtMaxBid" prefHeight="36.0" prefWidth="139.0" promptText="Giá tối đa" styleClass="text-input" />
                              <TextField fx:id="txtIncrementAuto" prefHeight="36.0" prefWidth="124.0" promptText="Bước nhảy" styleClass="text-input" />
                              <Button mnemonicParsing="false" onAction="#handleSetAutoBid" styleClass="btn-secondary" text="Đăng ký" />
                           </children>
                           <padding>
                              <Insets top="10.0" />
                           </padding>
                        </HBox>
                        <Label fx:id="lblAutoBidStatus" styleClass="label-muted" />
                     </children>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <padding>
                        <Insets bottom="5.0" />
                     </padding>
                  </VBox>

               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" top="5.0" />
               </padding>

            </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="14.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox prefHeight="227.0" prefWidth="494.0" styleClass="card">
                     <children>
                        <Label styleClass="column-header" text="📈 Biểu đồ giá" />
                        <LineChart fx:id="chartPrice" legendVisible="false" style="-fx-background-radius: 8; box-border-radius: 8;" VBox.vgrow="ALWAYS">
                          <xAxis>
                            <CategoryAxis label="Thời gian" side="BOTTOM" styleClass="label-muted" fx:id="xAxis" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis fx:id="yAxis" label="Giá (VNĐ)" side="LEFT" styleClass="label-muted" />
                          </yAxis>
                           <padding>
                              <Insets top="5.0" />
                           </padding>
                        </LineChart>
                     </children>
                  </VBox>

                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
                     <children>
                        <Label styleClass="column-header" text="📜 Lịch sử đặt giá" />
                        <ListView fx:id="lstBidHistory" prefHeight="200.0" prefWidth="200.0" style="-fx-background-radius: 8; -fx-border-radius: 8;" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>

               </children>
               
               <padding>
                  <Insets bottom="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>

         </children>
      </HBox>
   </center>
</BorderPane>
