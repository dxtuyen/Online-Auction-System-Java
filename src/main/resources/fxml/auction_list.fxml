<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="600.0" prefWidth="1100" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionListController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <left>
      <VBox prefWidth="200" spacing="6" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
         <padding>
            <Insets bottom="16" left="14" right="14" top="20" />
         </padding>
         <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="🔎 Trạng thái" />
         <Separator />
         <ToggleButton fx:id="filterAll" maxWidth="Infinity" selected="true" styleClass="filter-btn" text="Tất cả" userData="ALL" />
         <ToggleButton fx:id="filterPending" maxWidth="Infinity" styleClass="filter-btn" text="🕒 Sắp diễn ra" userData="PENDING" />
         <ToggleButton fx:id="filterRunning" maxWidth="Infinity" styleClass="filter-btn" text="🟢 Đang diễn ra" userData="RUNNING" />
         <ToggleButton fx:id="filterFinished" maxWidth="Infinity" styleClass="filter-btn" text="✅ Đã kết thúc" userData="FINISHED" />
         <ToggleButton fx:id="filterPaid" maxWidth="Infinity" styleClass="filter-btn" text="💰 Đã thanh toán" userData="PAID" />
         <ToggleButton fx:id="filterCanceled" maxWidth="Infinity" styleClass="filter-btn" text="🚫 Đã hủy" userData="CANCELED" />

         <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="📦 Loại sản phẩm">
            <VBox.margin>
               <Insets top="14" />
            </VBox.margin>
         </Label>
         <Separator />
         <CheckBox fx:id="catElectronics" styleClass="filter-check" text="📱 Điện tử" userData="ELECTRONICS" />
         <CheckBox fx:id="catArt" styleClass="filter-check" text="🎨 Nghệ thuật" userData="ART" />
         <CheckBox fx:id="catVehicle" styleClass="filter-check" text="🚗 Phương tiện" userData="VEHICLE" />
         <CheckBox fx:id="catFashion" styleClass="filter-check" text="👔 Thời trang" userData="FASHION" />
         <CheckBox fx:id="catCollectible" styleClass="filter-check" text="🏺 Sưu tầm" userData="COLLECTIBLE" />
         <CheckBox fx:id="catOther" styleClass="filter-check" text="📦 Khác" userData="OTHER" />
      </VBox>
   </left>

   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="46.0" spacing="12.0" styleClass="header-bar" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Label styleClass="label-title" text="🏛 Đấu giá Trực tuyến" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <StackPane>
               <Circle radius="16" style="-fx-fill: #e5e7eb; -fx-stroke: #cbd5e1; -fx-stroke-width: 1;" />
               <ImageView fx:id="imgHeaderAvatar" fitHeight="32" fitWidth="32" preserveRatio="false" />
            </StackPane>
            <Label fx:id="lblUserInfo" styleClass="label-muted" />
            <Button mnemonicParsing="false" onAction="#handleViewAccount" styleClass="btn-secondary" text="Tài khoản" />
            <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="btn-secondary" text="Đăng xuất" />
         </children></HBox>
   </top>

   <center>
       <VBox prefHeight="200.0" prefWidth="-1" maxWidth="Infinity" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="txtSearch" prefWidth="250.0" promptText="🔍  Tìm theo tên / ID..." styleClass="text-input" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-secondary" text="🔄 Refresh" />
                  <Button fx:id="btnCreateAuction" mnemonicParsing="false" onAction="#goToSellerDashboard" styleClass="btn-primary" text="+ Tạo phiên" />
               </children>
            </HBox>

            <ScrollPane fx:id="scrollAuctions" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #f8fafc;" VBox.vgrow="ALWAYS">
               <content>
                   <FlowPane fx:id="paneAuctions" hgap="14" vgap="14">
                     <padding>
                        <Insets bottom="6" left="0" right="0" top="0" />
                     </padding>
                  </FlowPane>
               </content>
            </ScrollPane>
            <Label fx:id="lblEmpty" styleClass="label-muted" text="Không có phiên đấu giá nào." visible="false" />
         </children>

         <padding>
            <Insets bottom="20.0" left="6.0" right="6.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
