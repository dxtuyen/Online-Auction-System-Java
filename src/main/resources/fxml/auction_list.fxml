<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="920" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionListController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <top>
      <HBox alignment="CENTER_LEFT" prefHeight="46.0" spacing="12.0" styleClass="header-bar" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Label styleClass="label-title" text="🏛 Đấu giá Trực tuyến" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUsername" styleClass="label-muted" text="tên user" />
            <Label styleClass="label-muted" text="| Số dư:" />
            <Label fx:id="lblBalance" styleClass="label-price" text="100000000" />
            <Button mnemonicParsing="false" onAction="#handleViewAccount" styleClass="btn-secondary" text="Hồ sơ" />
            <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="btn-secondary" text="Đăng xuất" />
         </children></HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField prefWidth="250.0" promptText="🔍  Tìm theo tên / ID..." styleClass="text-input" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-secondary" text="🔄 Refresh" />
                  <Button mnemonicParsing="false" onAction="#goToCreateAuction" styleClass="btn-primary" text="+ Tạo phiên đấu giá" />
               </children>
            </HBox>
            <TableView fx:id="tblAuctions" onMouseClicked="#handleTableClick" styleClass="label-muted" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colItem" prefWidth="230.0" text="Sản Phẩm" />
                  <TableColumn fx:id="colCategory" prefWidth="110.0" text="Danh mục" />
                  <TableColumn fx:id="colPrice" prefWidth="150.0" text="Giá hiện tại" />
                  <TableColumn fx:id="colBids" text="Lượt bid" />
                  <TableColumn fx:id="colStatus" prefWidth="130.0" text="Tạng thái" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
