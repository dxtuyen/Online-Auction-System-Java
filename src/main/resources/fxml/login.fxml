<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.LoginController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <children>
        <!-- VBox này là lớp nền, phủ kín toàn bộ cửa sổ và làm nhiệm vụ căn giữa -->
        <VBox alignment="CENTER" style="-fx-background-color: #f1f5f9;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- card trắng-->
                <VBox alignment="TOP_CENTER" maxWidth="400.0" prefWidth="350.0" spacing="15.0" styleClass="card">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>

                        <Label text="Login" textFill="#000000d5">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>

                        <!-- Form nhập tên đăng nhập -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Tên đăng nhập" textFill="#64748b" />
                                <TextField fx:id="txtUsername" prefHeight="40.0" promptText="Nhập tên đăng nhập" styleClass="text-input" />
                            </children>
                        </VBox>

                        <!-- Form nhập mật khẩu -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Mật khẩu" textFill="#64748b" />
                                <StackPane>
                                    <children>
                                        <PasswordField fx:id="txtPassword" prefHeight="40.0" promptText="••••••••" styleClass="text-input, password-with-eye" />
                                        <TextField fx:id="txtPasswordVisible" managed="false" prefHeight="40.0" promptText="••••••••" styleClass="text-input, password-with-eye" visible="false" />
                                        <ToggleButton fx:id="btnTogglePassword" focusTraversable="false" styleClass="eye-toggle" StackPane.alignment="CENTER_RIGHT">
                                            <graphic>
                                                <SVGPath fx:id="eyeIcon" content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5 12 4.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="#64748b" />
                                            </graphic>
                                        </ToggleButton>
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>

                  <Label fx:id="lblError" styleClass="label-error" />

                        <!-- nút đăng nhâp-->
                        <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" prefHeight="45.0" styleClass="btn-primary" text="Đăng nhập">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                        </Button>

                        <!-- link chuyển sang màn hình đăng kí-->
                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Chưa có tài khoản?" textFill="#64748b" />
                                <Hyperlink onAction="#goToRegister" style="-fx-underline: false;" text="Đăng ký ngay" textFill="#2563eb" />
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
