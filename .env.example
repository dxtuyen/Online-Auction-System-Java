MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=auction_db
MYSQL_USER=auction_user
MYSQL_PASSWORD=auction_pass

DB_URL=jdbc:mysql://localhost:3306/auction_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USER=auction_user
DB_PASSWORD=auction_pass

# Server runtime tuning (optional - dùng default nếu để trống)
SERVER_PORT=8888
SERVER_MAX_THREADS=100

# Anti-sniping: nếu có bid trong N giây cuối → gia hạn phiên thêm M giây
SNIPING_THRESHOLD_SECONDS=10
SNIPING_EXTENSION_SECONDS=30