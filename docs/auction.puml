package "com.auction.model.entity" {

  abstract class Entity <<Entity>> {
    - {final} id : UUID
    - {final} createdAt : LocalDateTime
    - updatedAt : LocalDateTime
    # Entity()
    # Entity(id : UUID, createdAt, updatedAt)
    # markUpdated() : void
    + getId() : UUID
    + {final} equals(o : Object) : boolean
    + {final} hashCode() : int
  }

  abstract class Item <<Entity>> {
    - name : String
    - description : String
    - {final} sellerId : UUID
    - startingPrice : BigDecimal
    - {final} images : List<String>
    - {final} category : ItemCategory
    - condition : ItemCondition
    + {abstract} getSpecificInfo() : String
    + {final} printInfo() : String
    + rename(newName : String) : void
    + updatePrice(p : BigDecimal) : void
    + addImage(url : String) : void
  }

  class Electronics <<Entity>> {
    - {final} brand : String
    - {final} model : String
    - {final} warrantyMonths : int
    + getSpecificInfo() : String
  }
  class Art <<Entity>> {
    - {final} artist : String
    - {final} yearCreated : Integer
    - {final} medium : String
    + getSpecificInfo() : String
  }
  class Vehicle <<Entity>> {
    - {final} make : String
    - {final} model : String
    - {final} year : int
    - {final} mileageKm : int
