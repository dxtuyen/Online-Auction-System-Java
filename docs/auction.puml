  }
  class OtherItem <<Entity>> {
    - extraInfo : String
    + getSpecificInfo() : String
    + updateExtraInfo(s : String) : void
  }

  class User <<Entity>> {
    - username : String
    - hashedPassword : String
    - passwordSalt : String
    - email : String
    - fullName : String
    - userStatus : UserStatus
    - role : Role
    - balance : BigDecimal
    - revenue : BigDecimal
    + <<synchronized>> checkPassword(plain : String) : boolean
    + <<synchronized>> changePassword(plain : String) : void
    + <<synchronized>> hasEnoughBalance(amt : BigDecimal) : boolean
    + <<synchronized>> tryReserve(amt : BigDecimal) : boolean
    + <<synchronized>> release(amt : BigDecimal) : void
